WORKER_API_TOKEN=
# Optional when videos have subtitles; required for speech recognition.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
# Exact frontend origins, comma-separated; no trailing slash or wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=./data
MAX_VIDEO_SECONDS=7200
# Optional: path to a privately mounted Netscape-format cookie file.
# YTDLP_COOKIE_FILE=/run/secrets/cookies.txt
